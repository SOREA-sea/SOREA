generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  email     String    @unique
  password  String
  phone     String?
  gender    String?
  birthDate DateTime?
  avatarUrl String?
  role      String    @default("user")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  timezone  String    @default("Europe/Paris")

  //  Email verification
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?

  //  2FA
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?

  sessions         UserSession[]
  coachProfile     CoachProfile?
  suppliers        Supplier[]
  payments         Payment[]
  orders           Order[]
  carts            Cart[]
  bookings         SessionBooking[]
  coachReviews     CoachReview[]
  sessionReviews   SessionReview[]
  coachComments    CoachComment[]
  sessionComments  SessionComment[]
  favoriteProducts FavoriteProduct[]
  favoriteCoaches  FavoriteCoach[]
  favoriteSessions FavoriteSession[]
  menstrualProfile MenstrualProfile?

  // carnet Gratitude
  habitChecks HabitCheck[]
  moodEntries MoodEntry[]
  journalNotes JournalNote[]
  quickNotes   QuickNote[]

  // carnet challenge
  dailyFeelings    DailyFeeling[]
  challengeItems   ChallengeItem[]
  hobbyCategories  HobbyCategory[]
  challengesSeeded Boolean @default(false)
  hobbiesSeeded    Boolean @default(false)

  symptomLogs      SymptomLog[]
  periodHistories  PeriodHistory[]

}

model MenstrualProfile {
  id                  Int       @id @default(autoincrement())
  userId              Int       @unique
  isActive            Boolean   @default(false)
  cycleLength         Int       @default(28)
  periodLength        Int       @default(5)
  lastPeriodStartDate DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PeriodHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  startDate DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SymptomLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  date             DateTime
  flow             String?
  mood             String?
  physicalSymptoms String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CoachProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  bio             String?
  specialty       String?
  experienceYears Int?
  hourlyRate      Float?
  averageRating   Float?   @default(0)
  verified        Boolean  @default(false)
  ambassador      Boolean  @default(false)
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      CoachSession[]
  coachReviews  CoachReview[]
  coachComments CoachComment[]
  favorites     FavoriteCoach[]
}

model ShopProduct {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  stockQuantity Int      @default(0)
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems        CartItem[]
  favoriteProducts FavoriteProduct[]
  orderItems       OrderItem[]
  supplierId       Int?
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Supplier {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  companyName     String?
  contactEmail    String?
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products ShopProduct[]
  orders   Order[]
}

model CoachSession {
  id              Int       @id @default(autoincrement())
  coachId         Int
  title           String
  description     String?
  sessionType     String?
  startsAt        DateTime?
  durationMinutes Int?
  capacity        Int?
  price           Float
  averageRating   Float?    @default(0)
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  coach           CoachProfile      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  bookings        SessionBooking[]
  sessionReviews  SessionReview[]
  sessionComments SessionComment[]
  favorites       FavoriteSession[]
}

model SessionBooking {
  id        Int          @id @default(autoincrement())
  sessionId Int
  userId    Int
  status    String       @default("pending")
  bookedAt  DateTime     @default(now())
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment / confirmation workflow (coach + user must confirm to release payment)
  coachConfirmed  Boolean @default(false)
  userConfirmed   Boolean @default(false)
  paymentReleased Boolean @default(false)

  paymentId Int?     @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])
}

model CoachReview {
  id         Int      @id @default(autoincrement())
  coachId    Int
  userId     Int
  rating     Float
  reviewText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionReview {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  userId     Int
  rating     Float
  reviewText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachComment {
  id          Int      @id @default(autoincrement())
  coachId     Int
  userId      Int
  commentText String
  createdAt   DateTime @default(now())

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionComment {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  userId      Int
  commentText String
  createdAt   DateTime @default(now())

  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  unitPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model FavoriteProduct {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model FavoriteCoach {
  id        Int      @id @default(autoincrement())
  userId    Int
  coachId   Int
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

model FavoriteSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  sessionId Int
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String   @id @default(uuid())
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Payments and marketplace accounting
model Payment {
  id                   Int      @id @default(autoincrement())
  amount               Float
  currency             String   @default("EUR")
  status               String   @default("pending") // pending, succeeded, refunded, failed
  method               String? // e.g., card
  stripeId             String?  @unique
  commissionPercentage Float?
  userId               Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Optional links
  sessionBooking SessionBooking? @relation()
  order          Order?          @relation(fields: [orderId], references: [id])
  orderId        Int?            @unique

  commissions Commission[]
  refunds     Refund[]
  disputes    Dispute[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id             Int      @id @default(autoincrement())
  userId         Int
  supplierId     Int
  total          Float
  currency       String   @default("EUR")
  status         String   @default("pending") // pending, paid, shipped, delivered, cancelled
  trackingNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payment  Payment?
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Float

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Commission {
  id              Int      @id @default(autoincrement())
  paymentId       Int
  platformAmount  Float
  recipientAmount Float
  percentage      Float
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Refund {
  id          Int      @id @default(autoincrement())
  paymentId   Int
  amount      Float
  reason      String?
  status      String   @default("pending") // pending, processed, failed
  processedBy Int?
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Dispute {
  id            Int      @id @default(autoincrement())
  paymentId     Int
  reason        String
  status        String   @default("open") // open, resolved, rejected
  adminDecision String?
  createdAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model SavezVous {
  id         Int      @id @default(autoincrement())
  date       String   @unique
  title      String
  paragraph1 String
  paragraph2 String
  paragraph3 String?
  createdAt  DateTime @default(now())
}
// carnet Gratitude planing

model HabitCheck {
  id        Int      @id @default(autoincrement())
  userId    Int
  habitId   String
  weekStart String   // "YYYY-MM-DD" du lundi de la semaine concernée
  dayIndex  Int      // 0=Lun ... 6=Dim
  checked   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, weekStart, dayIndex])
}
// carnet Gratitude planing
model MoodEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String   // "YYYY-MM-DD" du jour
  moodId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// carnet Gratitude journaling
model JournalNote {
  id          Int      @id @default(autoincrement())
  userId      Int
  texte       String
  humeurEmoji String?
  humeurLabel String?
  tag         String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// carnet Gratitude libre
model QuickNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  texte     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// carnet challenge 
model DailyFeeling {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  moodLabel String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ChallengeItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  theme     String
  label     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions ChallengeCompletion[]
}

model ChallengeCompletion {
  id              Int      @id @default(autoincrement())
  challengeItemId Int
  date            String
  createdAt       DateTime @default(now())

  challengeItem ChallengeItem @relation(fields: [challengeItemId], references: [id], onDelete: Cascade)

  @@unique([challengeItemId, date])
}

model HobbyCategory {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  icon      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items HobbyItem[]
}

model HobbyItem {
  id         Int      @id @default(autoincrement())
  categoryId Int
  label      String
  createdAt  DateTime @default(now())

  category HobbyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}